      "statusCode": 301
    },
    {
      "source": "/tags/khaenri-ah",
      "destination": "/lore/tags/khaenri-ah",
      "statusCode": 301
    },
    {
      "source": "/tags/liberte",
      "destination": "/lore/tags/liberte",
      "statusCode": 301
    },
    {
      "source": "/tags/mondstadt",
      "destination": "/lore/tags/mondstadt",
      "statusCode": 301
    },
    {
      "source": "/tags/quete-d-archons",
      "destination": "/lore/tags/quete-d-archons",
      "statusCode": 301
    },
    {
      "source": "/tags/teyvat",
      "destination": "/lore/tags/teyvat",
      "statusCode": 301
    },
    {
      "source": "/tags/voyageur",
      "destination": "/lore/tags/voyageur",
      "statusCode": 301
    },
    {
      "source": "/dossiers/commencer",
      "destination": "/lore/tags/premiers-pas",
      "statusCode": 301
    },
    {
      "source": "/lore/chronologie",
      "destination": "/lore",
      "statusCode": 301
    },
    {
      "source": "/lore/teyvat/mondstadt",
      "destination": "/lore/mondstadt",
      "statusCode": 301
    },
    {
      "source": "/lore/teyvat",
      "destination": "/lore/tags/regions",
      "statusCode": 301
    },
    {
      "source": "/categories/regions",
      "destination": "/lore/tags/regions",
      "statusCode": 301
    },
    {
      "source": "/categories/personnages",
      "destination": "/lore/tags/personnages",
      "statusCode": 301
    },
    {
      "source": "/categories/factions",
      "destination": "/lore/tags/factions",
      "statusCode": 301
    },
    {
      "source": "/categories/evenements",
      "destination": "/lore/tags/evenements",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
