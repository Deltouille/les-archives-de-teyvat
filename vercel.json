    },
    {
      "source": "/lore/factions",
      "destination": "/lore/tags/factions",
      "statusCode": 301
    },
    {
      "source": "/lore/evenements",
      "destination": "/lore/tags/evenements",
      "statusCode": 301
    },
    {
      "source": "/tags/abysse",
      "destination": "/lore/tags/abysse",
      "statusCode": 301
    },
    {
      "source": "/tags/anemo",
      "destination": "/lore/tags/anemo",
      "statusCode": 301
    },
    {
      "source": "/tags/archontes",
      "destination": "/lore/tags/archontes",
      "statusCode": 301
    },
    {
      "source": "/tags/barbatos",
      "destination": "/lore/tags/barbatos",
      "statusCode": 301
    },
    {
      "source": "/tags/dvalin",
      "destination": "/lore/tags/dvalin",
      "statusCode": 301
    },
    {
