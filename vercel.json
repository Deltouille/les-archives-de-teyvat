      "destination": "/lore/venti",
      "statusCode": 301
    },
    {
      "source": "/lore/factions/archons",
      "destination": "/lore/archons",
      "statusCode": 301
    },
    {
      "source": "/lore/factions/ordre-abysse",
      "destination": "/lore/ordre-abysse",
      "statusCode": 301
    },
    {
      "source": "/lore/evenements/cataclysme",
      "destination": "/lore/cataclysme",
      "statusCode": 301
    },
    {
      "source": "/lore/quetes",
      "destination": "/lore/tags/quetes",
      "statusCode": 301
    },
    {
      "source": "/lore/concepts",
      "destination": "/lore/tags/concepts",
      "statusCode": 301
    },
    {
