---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import PiedDePage from '../components/PiedDePage.astro';
import Recherche from '../components/Recherche.astro';
import { genererPalette } from '../../scripts/palette.mjs';

interface Props {
  titre: string;
  description?: string;
  /** Image de partage (chemin public ou URL d'image optimisée). */
  image?: string;
  article?: boolean;
  noindex?: boolean;
}
const {
  titre,
  description = 'Le lore de Genshin Impact, raconté simplement. Quêtes, personnages et mystères de Teyvat, en français.',
  image = '/social.webp',
  article = false,
  noindex = false,
} = Astro.props;

const NOM_DU_SITE = 'L’Histoire de Genshin';
const titreComplet = `${titre} · ${NOM_DU_SITE}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
const { clair, sombre } = genererPalette();

// Avec une bannière, la barre de navigation passe en surimpression transparente.
// On juge sur le rendu et non sur Astro.slots.has() : un slot conditionnel ({cond && <X slot="hero" />})
// compte comme présent même quand la condition est fausse.
const hero = Astro.slots.has('hero') ? await Astro.slots.render('hero') : '';
const avecHero = hero.trim() !== '';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={NOM_DU_SITE} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={clair.fond} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={sombre.fond} media="(prefers-color-scheme: dark)" />
    {/* Anti-flash : le thème est posé avant le premier rendu. Le choix mémorisé l'emporte sur la préférence système. */}
    <script is:inline>
      try {
        const memorise = localStorage.getItem('genshin-theme');
        document.documentElement.dataset.theme = memorise === 'dark' || memorise === 'light' ? memorise : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
    {/* View Transitions entre pages (D16) : seule la carte de l'article qu'on ouvre (pageswap), ou qu'on quitte en
         revenant en arrière (pagereveal), reçoit le nom de la bannière. Nommer toutes les cartes faisait voler
         vers leur nouvelle place celles qui existent aussi sur la page d'arrivée. En ligne et dans le <head> :
         pagereveal survient avant le premier rendu. */}
    <script is:inline>
      (() => {
        const carteDe = url => {
          const id = url && new URL(url).pathname.replace(/\/$/, '').match(/^\/lore\/([^/]+)$/)?.[1];
          return id ? document.querySelector(`[data-transition="image-${id}"]`) : null;
        };
        const nommer = (carte, transition) => {
          if (!carte || !transition) return;
          carte.style.viewTransitionName = carte.dataset.transition;
          transition.finished.finally(() => { carte.style.viewTransitionName = ''; });
        };
        addEventListener('pageswap', e => nommer(carteDe(e.activation?.entry?.url), e.viewTransition));
        addEventListener('pagereveal', e => nommer(carteDe(window.navigation?.activation?.from?.url), e.viewTransition));
      })();
    </script>
  </head>
  <body class="has-[[data-menu-ouvert]]:overflow-hidden has-[dialog[open]]:overflow-hidden">
    <a href="#contenu" class="text-etiquette-g fixed -top-20 left-4 z-50 rounded-full bg-primaire px-5 py-3 text-sur-primaire focus:top-4">Aller au contenu</a>
    <Navbar surHero={avecHero} />
    {/* Bannière rendue hors du <main>, directement en pleine largeur : pas de 100vw (qui inclut la barre de défilement). */}
    {avecHero && <Fragment set:html={hero} />}
    <main id="contenu" tabindex="-1" class="mx-auto min-h-[65svh] max-w-site px-4 pt-6 pb-16 focus:outline-none sm:px-6 lg:px-10">
      <slot />
    </main>
    <PiedDePage />
    <Recherche />
  </body>
</html>
