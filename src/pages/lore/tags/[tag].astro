---
import Site from '../../../layouts/Site.astro';
import Icon from '../../../components/Icon.astro';
import EnTetePage from '../../../components/EnTetePage.astro';
import FilAriane from '../../../components/FilAriane.astro';
import Puces from '../../../components/Puces.astro';
import GrilleArticles from '../../../components/GrilleArticles.astro';
import { bibliotheque, cheminTag, type Tag } from '../../../lib/contenu';
import { ordreDeLecture } from '../../../lib/bibliotheque.ts';

export async function getStaticPaths() {
  const { tags } = await bibliotheque();
  return tags.map(tag => ({ params: { tag: tag.id }, props: { tag } }));
}

const { tag } = Astro.props as { tag: Tag };
const { rubriques, avecTag } = await bibliotheque();
const { data } = tag;
// Épisodes de quête dans l'ordre de l'histoire, puis le reste par date.
const lectures = ordreDeLecture(avecTag(tag.id));
const nombre = `${lectures.length} lecture${lectures.length > 1 ? 's' : ''}`;
---
<Site titre={data.libelle} description={data.description}>
  <FilAriane etapes={[{ libelle: 'Accueil', href: '/' }, data.rubrique ? { libelle: 'Explorer', href: '/lore' } : { libelle: 'Sujets', href: '/lore/tags' }, { libelle: data.libelle }]} class="mb-6" />
  {/* Une rubrique a son emblème et les filtres de rubrique ; un sujet, seulement son titre et sa description (D53). */}
  <EnTetePage>
    {data.rubrique && data.icone && <span slot="embleme" class="grid size-14 shrink-0 place-items-center rounded-tres-grand bg-tonal text-sur-tonal sm:size-16" aria-hidden="true"><Icon nom={data.icone} taille={30} /></span>}
    {data.libelle}
    <Fragment slot="chapeau">{data.description}{lectures.length > 0 && <span class="text-etiquette-g mt-2 block" data-nombre-lectures>{nombre}</span>}</Fragment>
  </EnTetePage>
  {data.rubrique && <Puces puces={[{ href: '/lore', libelle: 'Tout explorer' }, ...rubriques.map(t => ({ href: cheminTag(t.id), libelle: t.data.libelle, icone: t.data.icone, actif: t.id === tag.id }))]} libelle="Changer de rubrique" />}
  {lectures.length > 0
    ? <GrilleArticles articles={lectures} niveau="h2" />
    : <p class="text-discret">Aucune lecture pour l’instant. <a class="lien-texte" href="/lore/tags">Voir tous les sujets <Icon nom="fleche" taille={18} /></a></p>}
</Site>
