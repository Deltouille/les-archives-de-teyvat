---
import Site from '../../../layouts/Site.astro';
import EnTetePage from '../../../components/EnTetePage.astro';
import EnTeteSection from '../../../components/EnTeteSection.astro';
import CarteTag from '../../../components/CarteTag.astro';
import { bibliotheque } from '../../../lib/contenu';
import { FAMILLES, type Famille } from '../../../lib/familles.ts';

// Les rubriques (le genre d'article), puis les sujets rangés par famille, dans l'ordre de FAMILLES (D53) ; une carte
// pour chacun.
const { rubriques, sujets, avecTag } = await bibliotheque();
const familles = (Object.entries(FAMILLES) as [Famille, string][])
  .map(([famille, libelle]) => ({ famille, libelle, sujets: sujets.filter(s => s.data.famille === famille) }))
  .filter(f => f.sujets.length > 0);
const grille = 'grid gap-4 sm:grid-cols-2 lg:grid-cols-3';
---
<Site titre="Rubriques et sujets" description="Les rubriques et les sujets du lore de Teyvat : régions, séries, groupes et notions, avec leur description.">
  <EnTetePage>Rubriques et sujets</EnTetePage>

  <EnTeteSection titre="Rubriques" />
  <ul class={grille} data-rubriques>
    {rubriques.map(t => <CarteTag tag={t} lectures={avecTag(t.id).length} />)}
  </ul>

  {familles.map(({ famille, libelle, sujets: liste }) => (
    <section aria-labelledby={`famille-${famille}`}>
      <EnTeteSection titre={libelle} id={`famille-${famille}`} />
      <ul class={grille} data-sujets={famille}>
        {liste.map(t => <CarteTag tag={t} lectures={avecTag(t.id).length} />)}
      </ul>
    </section>
  ))}
</Site>
