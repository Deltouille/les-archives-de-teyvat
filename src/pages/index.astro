---
// Accueil provisoire : la vraie page d'accueil (bannière, sections) arrive à l'étape 5 du plan.
// Il appelle déjà bibliotheque(), ce qui fait passer la validation du contenu à chaque build.
import Site from '../layouts/Site.astro';
import { bibliotheque } from '../lib/contenu';
import { dateFr } from '../lib/bibliotheque.mjs';

const { articles, themeDe } = await bibliotheque();
---
<Site titre="Accueil">
  <p class="sur-titre">Bienvenue, voyageur</p>
  <h1 class="mt-2">L’Histoire de Genshin</h1>
  <p class="mt-4 max-w-prose text-discret">Le lore de Genshin Impact, raconté simplement. Le site est en cours de reconstruction.</p>
  <h2 class="mt-12 mb-4">{articles.length} lectures</h2>
  <ul class="space-y-3" data-articles>
    {articles.map(article => (
      <li class="rounded-grand bg-surface p-4">
        <span class="pastille">{themeDe(article).data.singulier}</span>
        <strong class="text-titre-m mt-2 block">{article.data.titre}</strong>
        <span class="text-corps-m text-discret">{dateFr(article.data.publieLe)}</span>
      </li>
    ))}
  </ul>
</Site>
