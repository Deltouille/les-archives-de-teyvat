---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import Marque from '../components/Marque.astro';
---
<Site titre="Une page égarée dans Teyvat" noindex>
  <section class="flex min-h-[60svh] flex-col items-center justify-center gap-6 text-center">
    <p class="sur-titre">404 · Hors des sentiers</p>
    <Marque taille={72} class="text-primaire" />
    <h1>Même les voyageurs se perdent parfois.</h1>
    <p class="text-discret">Cette page n’existe pas, ou son histoire a changé d’adresse.</p>
    <a href="/lore" class="text-etiquette-g inline-flex h-12 items-center gap-2 rounded-full bg-primaire px-6 text-sur-primaire transition-colors hover:bg-primaire-survol">Retrouver les histoires <Icon nom="fleche" taille={20} /></a>
  </section>
</Site>
