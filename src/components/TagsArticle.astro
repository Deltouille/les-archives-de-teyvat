---
import { cheminTag, type Tag } from '../lib/contenu';
// Les sujets de l'article (sa rubrique est déjà dans le badge et le fil d'Ariane, D53). Rien sans sujet.
interface Props { tags: Tag[]; class?: string; }
const { tags } = Astro.props;
---
{tags.length > 0 && (
  <ul class:list={['flex flex-wrap gap-2', Astro.props.class ?? 'mt-8']} aria-label="Sujets de l’article" data-pagefind-ignore>
    {tags.map(t => <li><a class="text-etiquette-g flex h-8 items-center rounded-petit border border-contour px-3 text-primaire transition-colors hover:bg-texte/8" href={cheminTag(t.id)}>{t.data.libelle}</a></li>)}
  </ul>
)}
