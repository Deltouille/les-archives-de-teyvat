---
import CarteArticle from './CarteArticle.astro';
import { bibliotheque, type Article } from '../lib/contenu';
interface Props { articles: Article[]; niveau?: 'h2' | 'h3'; }
const { articles, niveau } = Astro.props;
const { tag, themeDe } = await bibliotheque();
const repere = (article: Article) => article.data.tags.map(tag).find(t => !t.data.theme)?.data.libelle ?? 'Teyvat';
---
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" data-grille-articles>
  {articles.map(article => <CarteArticle article={article} theme={themeDe(article)} repere={repere(article)} niveau={niveau} />)}
</div>
