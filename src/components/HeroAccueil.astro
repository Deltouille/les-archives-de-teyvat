---
import Icon from './Icon.astro';
import Banniere from './Banniere.astro';
import { cheminTag, imageDe } from '../lib/contenu';

const bouton = 'text-etiquette-g inline-flex min-h-12 items-center justify-center gap-3 rounded-full px-6 py-3 transition-colors duration-200 ease-standard focus-visible:outline-white';
---
<Banniere image={imageDe('fond-d-ecran')} titre="accueil-titre" class="hero-accueil min-h-[min(92svh,60rem)]">
  {/* Le contenu reste dans le flux : petits écrans et texte agrandi peuvent allonger la bannière. */}
  <div class="mx-auto flex w-full max-w-site flex-1 flex-col justify-center px-5 pt-32 pb-28 sm:px-6 sm:pt-44 md:pb-40 lg:px-10">
    <div class="max-w-[34rem]" data-introduction>
      <h1 id="accueil-titre" class="text-affichage-p text-shadow-lg sm:text-affichage-m lg:text-affichage-g">
        Chaque voyage<br />commence par <span class="block">une <em class="text-ciel">histoire.</em></span>
      </h1>
      <p class="text-corps-g mt-6 max-w-[36ch] text-pretty text-white/85 sm:text-titre-g">
        Des premiers pas aux secrets des Archontes, découvrez les histoires de Genshin Impact, en français.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-actions-accueil>
        <a class:list={[bouton, 'bg-ciel text-nuit shadow-niveau-2 hover:bg-ciel-clair']} href={cheminTag('premiers-pas')}>Commencer le voyage <Icon nom="fleche" taille={20} /></a>
        <a class:list={[bouton, 'border border-white/60 bg-nuit/35 text-white hover:bg-white/16']} href="/lore">Explorer le lore</a>
      </div>
    </div>
  </div>
  <a class="text-etiquette-g absolute left-1/2 bottom-28 hidden min-h-11 -translate-x-1/2 items-center gap-3 rounded-full px-4 text-white/85 transition-colors hover:bg-white/16 focus-visible:outline-white lg:flex" href="#contenu">
    Au fil des histoires <Icon nom="chevron" taille={20} class="rotate-90" />
  </a>
</Banniere>

<style>
  /* Le voile propre à l'accueil protège la colonne de lecture tout en laissant l'illustration respirer. */
  :global(.hero-accueil .voile-banniere) {
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-nuit) 92%, transparent), color-mix(in srgb, var(--color-nuit) 72%, transparent) 35%, transparent 75%),
      linear-gradient(0deg, color-mix(in srgb, var(--color-nuit) 85%, transparent), transparent 55%, color-mix(in srgb, var(--color-nuit) 35%, transparent));
  }
  @media (width < 600px) {
    :global(.hero-accueil > img) { object-position: 58% center; }
    :global(.hero-accueil .voile-banniere) {
      background: linear-gradient(0deg, color-mix(in srgb, var(--color-nuit) 96%, transparent), color-mix(in srgb, var(--color-nuit) 80%, transparent) 50%, color-mix(in srgb, var(--color-nuit) 75%, transparent) 100%);
    }
  }
</style>
